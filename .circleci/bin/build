#!/bin/sh

function build_image
{
    docker build \
      --build-arg KONG_DATABASE=off \
      --build-arg KONG_DECLARATIVE_CONFIG=/tmp/config.yml \
      --build-arg KONG_ADMIN_LISTEN=0.0.0.0:8001 \
      --build-arg KONG_PLUGINS=bellatrix_bridge \
      --build-arg KONG_GO_PLUGINS_DIR=/tmp/go-plugins \
      --build-arg KONG_PROXY_ACCESS_LOG=/dev/stdout \
      --build-arg KONG_PROXY_ERROR_LOG=/dev/stderr \
      --build-arg KONG_ADMIN_ACCESS_LOG=/dev/stdout \
      --build-arg KONG_ADMIN_ERROR_LOG=/dev/stderr \
      --build-arg KONG_LOG_LEVEL=info \
      -t gcr.io/stord-nonprod/kong:$CIRCLE_WORKFLOW_ID \
      -t gcr.io/stord-nonprod/kong:latest \
      ./
}

function run
{
  build_image
}

run