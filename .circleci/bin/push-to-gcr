#!/bin/sh

# This authenticates with GCR so that we can push images
function authenticate_gcr
{
  echo $NONPROD_GCLOUD_SERVICE_KEY | docker login -u _json_key --password-stdin https://gcr.io
}

# This pushes tagged images to GCR
function push_image_to_gcr
{
    docker push gcr.io/stord-nonprod/kong:$CIRCLE_WORKFLOW_ID
    # docker push gcr.io/stord-nonprod/kong:latest
}

# Sequencing of Operations
function run
{
  authenticate_gcr
  push_image_to_gcr
}

# lets do this thing
run