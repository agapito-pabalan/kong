#!/bin/sh

PIPELINE_ID=$1

# This authenticates with NonProd GCR so that we can pull images
function authenticate_nonprod_gcr
{
  echo $NONPROD_GCLOUD_SERVICE_KEY | docker login -u _json_key --password-stdin https://gcr.io
}

# This authenticates with Prod GCR so that we can push images
function authenticate_prod_gcr
{
  echo $PROD_GCLOUD_SERVICE_KEY | docker login -u _json_key --password-stdin https://gcr.io
}

# pull images from nonprod gcr
function pull_images_from_nonprod_gcr
{
    echo " [+] Pulling kong - $PIPELINE_ID NonProd"
    docker pull gcr.io/stord-nonprod/kong:$PIPELINE_ID
}

# This retags the images from prod to nonprod
function retag_nonprod_to_prod
{
    echo " [+] Retagging kong - $PIPELINE_ID - NonProd to Prod"
    docker tag gcr.io/stord-nonprod/kong:$PIPELINE_ID gcr.io/stord-production/kong:$PIPELINE_ID
    echo " [+] Retagging kong - latest - NonProd to Prod"
    docker tag gcr.io/stord-production/kong:$PIPELINE_ID gcr.io/stord-production/kong:latest
}

# This pushes tagged images to GCR
function push_images_to_prod_gcr
{
    echo " [+] Pushing kong - $PIPELINE_ID - Prod"
    docker push gcr.io/stord-production/kong:$PIPELINE_ID
    echo " [+] Pushing kong - latest - Prod"
    docker push gcr.io/stord-production/kong:latest
}

# Sequencing of Operations
function run
{
  authenticate_nonprod_gcr
  pull_images_from_nonprod_gcr

  retag_nonprod_to_prod
  
  authenticate_prod_gcr
  push_images_to_prod_gcr
}

# lets do this thing
run